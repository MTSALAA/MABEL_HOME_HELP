    "@prisma/client": "^6.19.3",
    "@react-email/render": "^2.1.0",
    "@sentry/nextjs": "^10.76.2",
    "@tanstack/react-table": "^8.21.3",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "@vercel/analytics": "^2.0.1",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
