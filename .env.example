# Copy to .env and fill in. Never commit .env.

# --- Database (local: `npm run db:start` serves this URL) --------------------
DATABASE_URL="postgresql://mabel:mabel@localhost:5433/mabel"
# Direct (non-pooled) URL, used for migrations. The names match what the Neon
# integration on Vercel creates, so nothing has to be copied by hand there.
DATABASE_URL_UNPOOLED="postgresql://mabel:mabel@localhost:5433/mabel"

# --- Site --------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Auth (Better Auth) ------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# First admin, created by the seed (`npm run db:seed`, or the Vercel build)
# while the database has no users. Password: at least 10 characters.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# --- Stripe (test keys locally and in preview; live keys in production only) -
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Set to "true" once the business is GST-registered and Stripe Tax is configured.
STRIPE_AUTOMATIC_TAX="false"

# --- Email (Resend). Without a key, emails are printed to the server console. -
RESEND_API_KEY=""
EMAIL_FROM="Mabel Home Help <hello@example.com>"

# --- Spam protection (Cloudflare Turnstile). Skipped when empty. -------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# --- Rate limiting (Upstash). Falls back to in-memory when empty. ------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Image uploads (UploadThing). Upload field is hidden when empty. ---------
UPLOADTHING_TOKEN=""

# --- Monitoring (Sentry). Disabled when empty. -------------------------------
SENTRY_DSN=""
